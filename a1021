                        window.matchMedia(
                            "(prefers-color-scheme: dark)"
                        ).matches
                            ? "dark"
                            : "light"
                    );

                document.documentElement.setAttribute(
                    "data-theme",
                    theme
                );

                document.documentElement.setAttribute(
                    "data-bs-theme",
                    theme
                );
            } catch (error) {
                // Fall back to the default light theme.
            }
        })();
    </script>

