### File 2 — `wwwroot/js/theme.js`

This is the main theme controller. It initializes the theme, reads and writes Local Storage, changes the HTML attributes, and updates the button.

```javascript

"use strict";

(() => {
    const STORAGE_KEY = "theme";

    const root = document.documentElement;

    function isValidTheme(theme) {
        return theme === "light" || theme === "dark";
    }

    function getSavedTheme() {
        try {
            const savedTheme = localStorage.getItem(STORAGE_KEY);

            return isValidTheme(savedTheme)
                ? savedTheme
                : null;
        } catch (error) {
            // Storage may be unavailable in restricted browsers.
            return null;
        }
    }

    function getSystemTheme() {
        try {
            return window.matchMedia(
                "(prefers-color-scheme: dark)"
            ).matches
                ? "dark"
                : "light";
        } catch (error) {
            return "light";
        }
    }

    function applyTheme(theme) {
        if (!isValidTheme(theme)) {
            theme = "light";
        }

        root.setAttribute("data-theme", theme);

        // Keep Bootstrap 5.3 color-mode styles synchronized.
        root.setAttribute("data-bs-theme", theme);

        return theme;
    }

    function saveTheme(theme) {
        try {
            localStorage.setItem(STORAGE_KEY, theme);
            return true;
        } catch (error) {
            // Theme still works for the current page,
            // but may not persist after navigation or refresh.
            return false;
        }
    }

    function updateThemeUI(theme) {
        const button = document.getElementById("themeToggle");
        const moonIcon = document.getElementById("themeMoonIcon");
        const sunIcon = document.getElementById("themeSunIcon");
        const buttonText = document.getElementById("themeToggleText");

        if (!button || !moonIcon || !sunIcon || !buttonText) {
            return;
        }

        const isDark = theme === "dark";

        // Moon in Light Mode; sun in Dark Mode.
        moonIcon.hidden = isDark;
        sunIcon.hidden = !isDark;

        // Describe the action the button will perform.
        buttonText.textContent = isDark
            ? "Light Mode"
            : "Dark Mode";

        button.setAttribute(
            "aria-label",
            isDark
                ? "Switch to light mode"
                : "Switch to dark mode"
        );

        button.setAttribute(
            "aria-pressed",
            String(isDark)
        );

        button.title = isDark
            ? "Switch to Light Mode"
            : "Switch to Dark Mode";
    }

    function initializeTheme() {
        // The head script may already have applied the theme.
        const currentTheme = root.getAttribute("data-theme");
        const savedTheme = getSavedTheme();

        // An explicit saved preference takes priority.
        const initialTheme = savedTheme
            || (isValidTheme(currentTheme)
                ? currentTheme
                : getSystemTheme());

        const theme = applyTheme(initialTheme);

        updateThemeUI(theme);

        const button = document.getElementById("themeToggle");

        if (button) {
            button.addEventListener("click", () => {
                const activeTheme =
                    root.getAttribute("data-theme") || "light";

                const nextTheme = activeTheme === "dark"
                    ? "light"
                    : "dark";

                const appliedTheme = applyTheme(nextTheme);

                saveTheme(appliedTheme);
                updateThemeUI(appliedTheme);
            });
        }
    }

    // Initialize after the HTML has been parsed.
    if (document.readyState === "loading") {
        document.addEventListener(
            "DOMContentLoaded",
            initializeTheme,
            { once: true }
        );
    } else {
        initializeTheme();
    }
})();
```

### Understanding how the JavaScript works

1\. `STORAGE_KEY`

```javascript
const STORAGE_KEY = "theme";
```

This defines the key used for saving and retrieving the preference. Reusing a constant prevents spelling inconsistencies.

2\. `getSavedTheme()`

Reads the value from Local Storage. If storage is unavailable or the value is invalid, the function returns `null`.

3\. `getSystemTheme()`

Checks the operating system's current color preference. It is used only when no saved theme exists and no valid theme has already been applied.

4\. `applyTheme()`

Updates both `data-theme` and `data-bs-theme`. The first attribute controls our custom CSS; the second enables Bootstrap 5.3's built-in color modes.

5\. `saveTheme()`

Writes the preference to Local Storage. It returns `false` if storage cannot be accessed, but does not prevent the theme from changing on the current page.

6\. `updateThemeUI()`

Finds the button and icons and updates their visibility, text, tooltip, and accessibility attributes. The null checks prevent errors if an element is missing.

7\. `initializeTheme()`

Sets the initial theme and attaches the click handler. The event handler determines the opposite theme, applies it, saves it, and updates the button.

The script is wrapped in an immediately invoked function expression (IIFE). This keeps its variables and helper functions out of the global JavaScript scope.

